<% content_for :title, "Home · #{pool_name}" %>

<% if @watch_parties.any? %>
  <section class="rounded-xl bg-gradient-to-r from-amber-500 to-rose-500 text-white shadow-lg px-5 py-4 mb-6">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xl">📣</span>
      <h2 class="font-bold tracking-tight">Watch parties happening now</h2>
    </div>
    <ul class="space-y-1.5">
      <% @watch_parties.each do |wp| %>
        <li class="text-sm sm:text-base">
          <span class="font-semibold"><%= wp.user.name_with_flag %></span>
          is watching <span class="font-semibold"><%= wp.game_name %></span>
          at <span class="font-semibold underline decoration-white/40"><%= wp.location %></span>
        </li>
      <% end %>
    </ul>
    <% if user_signed_in? %>
      <%= link_to "Post your own watch party →", profile_path,
            class: "inline-block mt-3 text-sm font-semibold text-white/90 hover:text-white" %>
    <% end %>
  </section>
<% end %>

<% if user_signed_in? && @my_rank %>
  <%= link_to standings_path,
        class: "flex flex-wrap items-center justify-between gap-x-6 gap-y-2 rounded-xl bg-white border border-slate-200 shadow px-5 py-4 mb-6 hover:border-emerald-300 hover:shadow-md transition cursor-pointer" do %>
    <div class="flex items-center gap-3">
      <span class="text-2xl">🏆</span>
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-500">Leader</p>
        <p class="font-semibold text-slate-900">
          <%= @leader.name_with_flag %>
          <span class="text-slate-500 font-normal">· <%= @leader_points %> <%= "pt".pluralize(@leader_points) %></span>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-2xl">📍</span>
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-500">You</p>
        <p class="font-semibold text-slate-900">
          <span class="text-emerald-700 font-extrabold">#<%= @my_rank %></span>
          <span class="text-slate-500 font-normal">of <%= @total_players %> · <%= @my_points %> <%= "pt".pluralize(@my_points) %></span>
        </p>
      </div>
    </div>
    <span class="ml-auto text-sm font-semibold text-emerald-700">View standings →</span>
  <% end %>
<% end %>

<section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-700 via-emerald-600 to-rose-600 p-10 text-white shadow-xl mb-10 cursor-default">
  <%= image_tag "striker.png", alt: "Striker, the USA '94 mascot",
        class: "hidden md:block absolute -right-4 -bottom-6 w-48 lg:w-60 z-10 drop-shadow-2xl pointer-events-none select-none" %>
  <div class="relative z-10">
    <p class="text-sm uppercase tracking-widest text-emerald-100 text-center">June 11 – July 19, 2026</p>

    <% if @first_kickoff_at %>
      <div class="mt-6"
           data-controller="countdown"
           data-countdown-kickoff-value="<%= @first_kickoff_at.iso8601 %>">
        <div class="flex justify-center items-baseline gap-3 md:gap-6 font-mono tabular-nums" data-countdown-target="clock">
          <div class="text-center">
            <div class="text-4xl md:text-6xl font-bold leading-none" data-countdown-target="days">--</div>
            <div class="mt-1 text-[0.65rem] md:text-xs uppercase tracking-widest text-emerald-100">days</div>
          </div>
          <div class="text-4xl md:text-6xl font-bold text-emerald-200 leading-none">:</div>
          <div class="text-center">
            <div class="text-4xl md:text-6xl font-bold leading-none" data-countdown-target="hours">--</div>
            <div class="mt-1 text-[0.65rem] md:text-xs uppercase tracking-widest text-emerald-100">hours</div>
          </div>
          <div class="text-4xl md:text-6xl font-bold text-emerald-200 leading-none">:</div>
          <div class="text-center">
            <div class="text-4xl md:text-6xl font-bold leading-none" data-countdown-target="minutes">--</div>
            <div class="mt-1 text-[0.65rem] md:text-xs uppercase tracking-widest text-emerald-100">min</div>
          </div>
          <div class="text-4xl md:text-6xl font-bold text-emerald-200 leading-none">:</div>
          <div class="text-center">
            <div class="text-4xl md:text-6xl font-bold leading-none" data-countdown-target="seconds">--</div>
            <div class="mt-1 text-[0.65rem] md:text-xs uppercase tracking-widest text-emerald-100">sec</div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="mt-8 grid grid-cols-8 md:grid-cols-12 gap-1 text-2xl md:text-3xl leading-none place-items-center">
      <% @team_flags.each do |flag, name| %>
        <span class="relative group inline-block">
          <span class="block hover:scale-125 transition-transform duration-150" aria-label="<%= name %>"><%= flag %></span>
          <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded-md bg-slate-900 text-white text-xs font-semibold tracking-normal whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-100 shadow-lg z-20"><%= name %></span>
        </span>
      <% end %>
    </div>

    <div class="mt-10 flex justify-center">
      <%= link_to "My Picks", group_picks_path,
                  class: "inline-block bg-white text-emerald-700 font-extrabold uppercase tracking-wider text-lg md:text-xl px-10 py-5 rounded-xl shadow-lg ring-4 ring-white/30 hover:bg-emerald-50 hover:scale-105 active:scale-95 transition-transform duration-150 cursor-pointer" %>
    </div>
  </div>
  <div class="absolute -left-10 -bottom-10 text-[14rem] opacity-10">⚽</div>
</section>

<section class="mb-10">
  <div class="rounded-xl bg-white shadow p-6">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
      <h2 class="font-semibold text-slate-900">Next up</h2>
      <% if @next_day %>
        <p class="text-sm font-medium text-slate-500"><%= @next_day.strftime("%A, %b %-d") %></p>
      <% end %>
    </div>

    <% if @next_matches.any? || @next_knockouts.any? %>
      <ul class="divide-y divide-slate-100">
        <% @next_matches.each do |match| %>
          <% pick = @match_picks[match.id] %>
          <li class="py-3 first:pt-0 last:pb-0">
            <p class="text-xs uppercase tracking-wide text-slate-400">Group <%= match.group.letter %> · Match <%= match.number %></p>
            <p class="text-lg font-semibold mt-1"><%= match.home_team.flag_emoji %> <%= match.home_team.name %> vs <%= match.away_team.name %> <%= match.away_team.flag_emoji %></p>
            <p class="text-sm text-slate-600 mt-1"><%= match.kickoff_at.strftime("%-l:%M %p") %> · <%= match.venue %></p>
            <% if user_signed_in? %>
              <% if pick&.group_result %>
                <% picked_team = { "home" => match.home_team, "away" => match.away_team }[pick.group_result] %>
                <p class="text-sm mt-1">
                  <span class="text-slate-500">Your pick:</span>
                  <span class="font-semibold text-emerald-700"><%= picked_team ? "#{picked_team.flag_emoji} #{picked_team.name}" : "Draw" %></span>
                </p>
              <% else %>
                <p class="text-sm mt-1">
                  <span class="text-slate-500">Your pick:</span>
                  <%= link_to "none yet — make your pick", group_picks_path, class: "font-medium text-rose-600 hover:underline" %>
                </p>
              <% end %>
            <% end %>
          </li>
        <% end %>

        <% @next_knockouts.each do |ko| %>
          <% pick = @knockout_picks[ko.id] %>
          <li class="py-3 first:pt-0 last:pb-0">
            <p class="text-xs uppercase tracking-wide text-slate-400"><%= ko.round_name %></p>
            <p class="text-lg font-semibold mt-1"><%= ko.home_team&.name || ko.home_slot&.display_label %> vs <%= ko.away_team&.name || ko.away_slot&.display_label %></p>
            <p class="text-sm text-slate-600 mt-1"><%= ko.kickoff_at&.strftime("%-l:%M %p") %></p>
            <% if user_signed_in? %>
              <% if pick&.team %>
                <p class="text-sm mt-1">
                  <span class="text-slate-500">Your pick:</span>
                  <span class="font-semibold text-emerald-700"><%= pick.team.flag_emoji %> <%= pick.team.name %></span>
                </p>
              <% else %>
                <p class="text-sm mt-1">
                  <span class="text-slate-500">Your pick:</span>
                  <%= link_to "none yet — make your pick", bracket_picks_path, class: "font-medium text-rose-600 hover:underline" %>
                </p>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500">Tournament is over. Thanks for playing!</p>
    <% end %>
  </div>
</section>

<section class="mb-10">
  <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
    <div>
      <h2 class="text-xl font-extrabold tracking-tight">Latest from the pool</h2>
      <p class="text-sm text-slate-600">Photos and videos from everyone's World Cup.</p>
    </div>
    <%= link_to "Open the feed →", feed_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
  </div>

  <% if @recent_posts.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <% @recent_posts.each do |post| %>
        <%= link_to feed_post_path(post), class: "rounded-xl bg-white shadow overflow-hidden flex flex-col group" do %>
          <div class="bg-slate-900 flex items-center justify-center aspect-square overflow-hidden">
            <% if post.image? %>
              <%= image_tag post.media, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-200", loading: "lazy", alt: post.caption.presence || "Feed photo" %>
            <% elsif post.video? %>
              <span class="text-6xl">🎬</span>
            <% end %>
          </div>
          <div class="p-4 flex items-center justify-between gap-2 text-xs text-slate-500">
            <span class="truncate">
              <span class="font-medium text-slate-700"><%= post.user.name_with_flag %></span>
              <% if post.caption.present? %> · <%= truncate(post.caption, length: 40) %><% end %>
            </span>
            <span class="text-emerald-700 font-medium whitespace-nowrap">💬 <%= post.comments.size %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl bg-white shadow p-10 text-center text-slate-500">
      <%= image_tag "striker.png", alt: "Striker, the USA '94 mascot", class: "h-24 w-auto mx-auto mb-3 drop-shadow-sm" %>
      No posts yet —
      <%= link_to "be the first to share a moment!", feed_path, class: "text-emerald-700 font-semibold hover:underline" %>
    </div>
  <% end %>
</section>

<section class="mb-10">
  <div class="rounded-xl bg-white shadow p-6">
    <h2 class="font-semibold text-slate-900 mb-4">Leaderboard preview</h2>
    <% if @top_players.any? %>
      <ol class="space-y-2">
        <% @top_players.each_with_index do |p, i| %>
          <li class="flex items-center justify-between border-b border-slate-100 pb-2 last:border-0">
            <span class="flex items-center gap-2">
              <span class="text-xs font-bold text-slate-400 w-5"><%= i + 1 %>.</span>
              <span class="font-medium"><%= p.name_with_flag %></span>
            </span>
            <span class="text-emerald-700 font-bold"><%= p.total %> pts</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-sm text-slate-500">No picks scored yet.</p>
    <% end %>
    <%= link_to "Full standings →", standings_path, class: "inline-block mt-4 text-sm font-medium text-emerald-700 hover:underline" %>
  </div>
</section>

<section class="grid md:grid-cols-3 gap-6">
  <div class="rounded-xl bg-white shadow p-6">
    <h2 class="font-semibold text-slate-900 mb-2">Scoring</h2>
    <ul class="text-sm text-slate-600 space-y-1">
      <li>Group game: <span class="font-semibold">1 pt</span></li>
      <li>Round of 32: <span class="font-semibold">2 pts</span></li>
      <li>Round of 16: <span class="font-semibold">4 pts</span></li>
      <li>Quarterfinal: <span class="font-semibold">6 pts</span></li>
      <li>Semifinal: <span class="font-semibold">8 pts</span></li>
      <li>Final: <span class="font-semibold">10 pts</span></li>
    </ul>
  </div>
  <div class="rounded-xl bg-white shadow p-6">
    <h2 class="font-semibold text-slate-900 mb-2">Locks</h2>
    <p class="text-sm text-slate-600">All group picks must be in before the first group game kicks off. All bracket picks must be in before the first R32 match kicks off. No late picks.</p>
  </div>
  <div class="rounded-xl bg-white shadow p-6">
    <h2 class="font-semibold text-slate-900 mb-2">Pool size</h2>
    <p class="text-3xl font-bold text-emerald-700"><%= @user_count %></p>
    <p class="text-sm text-slate-600">player<%= @user_count == 1 ? "" : "s" %> registered</p>
  </div>
</section>
