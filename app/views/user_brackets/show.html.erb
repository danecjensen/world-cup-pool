<% content_for :title, "#{@user.display_name}'s bracket" %>

<div class="flex flex-wrap items-end justify-between mb-6 gap-2">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight"><%= @user.name_with_flag %>'s bracket</h1>
    <p class="text-slate-600 mt-1 text-sm">Their knockout picks, read-only. Scroll sideways to reach the later rounds and the final.</p>
  </div>
  <%= link_to "← Back to standings", standings_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
</div>

<% if @picks_by_km.empty? %>
  <div class="rounded-md bg-slate-50 border border-slate-200 text-slate-600 px-4 py-3 mb-6 text-sm">
    <%= @user.display_name %> hasn't made any bracket picks.
  </div>
<% end %>

<div data-controller="bracket"
     data-bracket-picks-value="<%= @picks_by_km.transform_values(&:team_id).to_json %>"
     data-bracket-locked-value="true">
  <%= render "bracket_picks/bracket_tree", rounds: @rounds, matches_by_round: @matches_by_round,
                                           picks_by_km: @picks_by_km, locked: true %>
</div>
