<% content_for :title, "Add your nation flag" %>

<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Fly your flag</h1>
    <p class="text-slate-600 mt-1 text-sm">
      Tell everyone which nation you're supporting and we'll add its flag emoji
      right next to your name across the pool.
    </p>
  </div>

  <section class="bg-white rounded-xl shadow p-6">
    <% if current_user.supports_nation? %>
      <div class="mb-5 flex items-center gap-3 rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3">
        <span class="text-3xl"><%= current_user.support_flag %></span>
        <div class="text-sm">
          <p class="font-semibold text-emerald-900">You're supporting <%= current_user.support_nation %></p>
          <p class="text-emerald-700">Your name shows as <span class="font-medium"><%= current_user.name_with_flag %></span></p>
        </div>
      </div>
    <% end %>

    <%= form_with url: update_flag_profile_path, method: :patch, html: { class: "space-y-4" } do |f| %>
      <% if @flag_error.present? %>
        <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm px-3 py-2 rounded">
          <p><%= @flag_error %></p>
        </div>
      <% end %>

      <div>
        <%= label_tag "user_support_nation", "Nation you support", class: "block text-sm font-medium text-slate-700" %>
        <%= text_field_tag "user[support_nation]", current_user.support_nation,
              id: "user_support_nation", list: "nation-options", autofocus: true,
              placeholder: "Pick one of the 48 World Cup nations",
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
        <datalist id="nation-options">
          <% @world_cup_nations.each do |nation| %>
            <option value="<%= nation %>"></option>
          <% end %>
        </datalist>
        <p class="mt-1 text-xs text-slate-400">Leave blank and save to remove the flag from your name.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit "Save flag", class: "bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-md" %>
        <%= link_to "Back to profile", profile_path, class: "text-sm font-medium text-slate-600 hover:text-slate-800 underline" %>
      </div>
    <% end %>
  </section>
</div>
