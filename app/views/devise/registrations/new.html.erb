<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
  <h1 class="text-2xl font-extrabold tracking-tight mb-2">Join the pool</h1>
  <p class="text-sm text-slate-500 mb-6">Open registration. Anyone can play.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm px-3 py-2 rounded">
        <% resource.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :display_name, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :display_name, autofocus: true, autocomplete: "nickname", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      <p class="text-xs text-slate-500 mt-1">This is shown on the leaderboard.</p>
    </div>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-slate-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <%= f.submit "Create account", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 rounded-md" %>
  <% end %>

  <div class="mt-6 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
