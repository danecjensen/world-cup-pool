<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
  <h1 class="text-2xl font-extrabold tracking-tight mb-2">Forgot your password?</h1>
  <p class="text-sm text-slate-500 mb-6">Enter your email and we'll send you a link to reset it.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm px-3 py-2 rounded">
        <% resource.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <%= f.submit "Send reset instructions", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 rounded-md" %>
  <% end %>

  <div class="mt-6 text-sm text-slate-600 space-y-1">
    <%= render "devise/shared/links" %>
  </div>
</div>
