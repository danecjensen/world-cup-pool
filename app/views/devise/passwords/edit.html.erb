<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
  <h1 class="text-2xl font-extrabold tracking-tight mb-6">Choose a new password</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <% if resource.errors.any? %>
      <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm px-3 py-2 rounded">
        <% resource.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-slate-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <%= f.submit "Change my password", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 rounded-md" %>
  <% end %>

  <div class="mt-6 text-sm text-slate-600 space-y-1">
    <%= render "devise/shared/links" %>
  </div>
</div>
