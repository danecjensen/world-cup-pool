<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
  <h1 class="text-2xl font-extrabold tracking-tight mb-6">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :remember_me, class: "rounded border-slate-300" %>
        <span>Remember me</span>
      </label>
    <% end %>
    <%= f.submit "Sign in", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 rounded-md" %>
  <% end %>

  <div class="mt-6 text-sm text-slate-600 space-y-1">
    <%= render "devise/shared/links" %>
  </div>
</div>
