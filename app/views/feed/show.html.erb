<% content_for :title, "Post by #{@post.user.display_name}" %>

<div class="max-w-2xl mx-auto">
  <%= link_to "← Back to feed", feed_path, class: "inline-block text-sm font-medium text-emerald-700 hover:text-emerald-800 hover:underline mb-4" %>

  <div class="rounded-xl bg-white shadow overflow-hidden mb-6">
    <%= render "feed/post_content", post: @post, linked: false %>

    <div class="p-5">
      <% if @post.pending? %>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 mb-3 rounded-full bg-amber-100 text-amber-800 text-xs font-medium">⏳ Pending admin approval</span>
      <% end %>
      <% if @post.caption.present? %>
        <p class="text-slate-800 whitespace-pre-line mb-3"><%= @post.caption %></p>
      <% end %>
      <div class="flex items-center justify-between text-sm text-slate-500">
        <span class="font-semibold text-slate-700"><%= @post.user.display_name %></span>
        <span><%= time_ago_in_words(@post.created_at) %> ago</span>
      </div>
      <% if can_moderate?(@post) %>
        <%= button_to "Delete post", feed_post_path(@post), method: :delete,
              form: { data: { turbo_confirm: "Delete this post?" } },
              class: "mt-3 text-xs text-rose-600 hover:text-rose-800 hover:underline" %>
      <% end %>
    </div>
  </div>

  <section class="rounded-xl bg-white shadow p-5">
    <h2 class="text-lg font-bold tracking-tight mb-4">
      Comments
      <span class="text-sm font-normal text-slate-400">(<%= @post.comments.size %>)</span>
    </h2>

    <% comments = @post.comments.oldest_first %>
    <% if comments.any? %>
      <ul class="divide-y divide-slate-100 mb-5">
        <% comments.each do |comment| %>
          <li class="py-3">
            <div class="flex items-baseline justify-between gap-2 mb-1">
              <span class="text-sm font-semibold text-slate-700"><%= comment.user.display_name %></span>
              <span class="text-xs text-slate-400 whitespace-nowrap"><%= time_ago_in_words(comment.created_at) %> ago</span>
            </div>
            <p class="text-sm text-slate-800 whitespace-pre-line"><%= comment.body %></p>
            <% if can_moderate?(comment) %>
              <%= button_to "Delete", feed_post_comment_path(@post, comment.id), method: :delete,
                    form: { data: { turbo_confirm: "Delete this comment?" } },
                    class: "mt-1 text-xs text-rose-600 hover:text-rose-800 hover:underline" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500 mb-5">No comments yet — be the first to chime in!</p>
    <% end %>

    <% if user_signed_in? %>
      <%= form_with model: @comment, url: feed_post_comments_path(@post), method: :post do |f| %>
        <%= f.text_area :body,
              rows: 2,
              maxlength: 500,
              required: true,
              placeholder: "Add a comment…",
              class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-emerald-500 mb-3" %>
        <%= f.submit "Comment", class: "px-5 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm cursor-pointer" %>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-600">
        <%= link_to "Sign in", new_user_session_path, class: "text-emerald-700 font-semibold hover:underline" %>
        to join the conversation.
      </p>
    <% end %>
  </section>
</div>
