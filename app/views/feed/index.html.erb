<% content_for :title, "Feed" %>

<h1 class="text-3xl font-extrabold tracking-tight mb-2">Feed</h1>
<p class="text-slate-600 mb-6 text-sm">Share your World Cup moments — photos, videos, links, and posts from Instagram &amp; Threads.</p>

<% if user_signed_in? %>
  <div class="rounded-xl bg-white shadow p-5 mb-8">
    <%= form_with model: @post, url: feed_path, method: :post,
          html: { multipart: true, data: { turbo: false, controller: "post-form" } } do |f| %>
      <% if @post.errors.any? %>
        <div class="bg-rose-100 border border-rose-300 text-rose-900 px-4 py-3 rounded-md mb-4 text-sm">
          <ul class="list-disc list-inside">
            <% @post.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.hidden_field :post_type, value: @post.post_type.presence || "media",
            data: { "post-form-target": "typeField" } %>

      <%# What kind of post? Each tab swaps in the relevant input below. %>
      <div class="flex flex-wrap gap-2 mb-4">
        <% [["media", "📷 Photo / Video"], ["link", "🔗 Link"], ["instagram", "📸 Instagram"], ["threads", "🧵 Threads"]].each do |type, label| %>
          <button type="button"
                  data-action="post-form#select"
                  data-post-form-target="tab"
                  data-type="<%= type %>"
                  data-post-form-type-param="<%= type %>"
                  class="px-3 py-1.5 rounded-full text-sm font-semibold bg-slate-100 text-slate-600 cursor-pointer">
            <%= label %>
          </button>
        <% end %>
      </div>

      <%# Media upload %>
      <div data-post-form-target="panel" data-types="media">
        <label class="block text-sm font-medium text-slate-700 mb-1">Photo or video</label>
        <%# Direct uploads (browser -> S3) keep big videos off the dyno and away from
            Heroku's 30s timeout. Set ACTIVE_STORAGE_DIRECT_UPLOADS=false to proxy
            uploads through the app instead (no bucket CORS needed). %>
        <% direct_uploads = ActiveModel::Type::Boolean.new.cast(ENV.fetch("ACTIVE_STORAGE_DIRECT_UPLOADS", true)) %>
        <%= f.file_field :media,
              accept: "image/*,video/*",
              direct_upload: direct_uploads,
              class: "block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer mb-4" %>
      </div>

      <%# Link / Instagram / Threads all share the URL field; the hint changes. %>
      <div data-post-form-target="panel" data-types="link instagram threads">
        <label class="block text-sm font-medium text-slate-700 mb-1">URL</label>
        <%= f.text_field :link_url,
              type: "url",
              placeholder: "https://…",
              class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-emerald-500 mb-2" %>
        <p data-post-form-target="panel" data-types="link" class="text-xs text-slate-500 mb-4">Paste any link — we'll pull in its preview image and description.</p>
        <p data-post-form-target="panel" data-types="instagram" class="text-xs text-slate-500 mb-4">Paste an Instagram post, reel or TV link (e.g. instagram.com/p/…) — it'll be embedded.</p>
        <p data-post-form-target="panel" data-types="threads" class="text-xs text-slate-500 mb-4">Paste a Threads post link (e.g. threads.net/@user/post/…) — it'll be embedded.</p>
      </div>

      <label class="block text-sm font-medium text-slate-700 mb-1">Caption <span class="text-slate-400 font-normal">(optional)</span></label>
      <%= f.text_area :caption,
            rows: 2,
            maxlength: 500,
            placeholder: "Say something about your post…",
            class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-emerald-500 mb-4" %>

      <%= f.submit "Share", class: "px-5 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm cursor-pointer" %>
      <p class="mt-3 text-xs text-slate-500">Posts are reviewed by an admin before they appear in the feed.</p>
    <% end %>
  </div>

  <% if @pending_posts.any? %>
    <div class="rounded-xl bg-amber-50 border border-amber-200 p-5 mb-8">
      <h2 class="text-sm font-semibold text-amber-900 mb-3">⏳ Awaiting approval</h2>
      <ul class="space-y-3">
        <% @pending_posts.each do |post| %>
          <li class="flex items-center gap-3">
            <div class="w-14 h-14 rounded-md overflow-hidden bg-slate-900 flex items-center justify-center shrink-0">
              <% if post.image? %>
                <%= image_tag post.media, class: "w-full h-full object-cover", loading: "lazy", alt: "Pending post" %>
              <% elsif post.link? && post.og_image_url.present? %>
                <%= image_tag post.og_image_url, class: "w-full h-full object-cover", loading: "lazy", alt: "Pending link", referrerpolicy: "no-referrer" %>
              <% else %>
                <span class="text-white text-xl"><%= post.video? ? "🎬" : post.instagram? ? "📸" : post.threads? ? "🧵" : "🔗" %></span>
              <% end %>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-slate-700 truncate"><%= post.caption.presence || post.og_title.presence || post.link_url.presence || "Your post" %></p>
              <p class="text-xs text-amber-700">Submitted <%= time_ago_in_words(post.created_at) %> ago — pending review</p>
            </div>
            <%= button_to "Cancel", feed_post_path(post), method: :delete,
                  form: { data: { turbo_confirm: "Delete this pending post?" } },
                  class: "text-xs text-rose-600 hover:text-rose-800 hover:underline shrink-0" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% else %>
  <div class="rounded-xl bg-white shadow p-5 mb-8 text-sm text-slate-600">
    <%= link_to "Sign in", new_user_session_path, class: "text-emerald-700 font-semibold hover:underline" %>
    to share your own photos, videos and links.
  </div>
<% end %>

<% if @posts.empty? %>
  <div class="rounded-xl bg-white shadow p-10 text-center text-slate-500">
    No posts yet — be the first to share a moment!
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @posts.each do |post| %>
      <div class="rounded-xl bg-white shadow overflow-hidden flex flex-col">
        <%= render "feed/post_content", post: post, linked: true %>

        <div class="p-4 flex flex-col gap-2 flex-1">
          <% if post.caption.present? %>
            <p class="text-sm text-slate-800 whitespace-pre-line"><%= link_to post.caption, feed_post_path(post), class: "hover:underline" %></p>
          <% end %>
          <div class="mt-auto flex items-center justify-between text-xs text-slate-500 pt-2">
            <span class="font-medium text-slate-700"><%= post.user.name_with_flag %></span>
            <span><%= time_ago_in_words(post.created_at) %> ago</span>
          </div>
          <%= link_to "💬 #{pluralize(post.comments.size, 'comment')}", feed_post_path(post), class: "text-xs text-emerald-700 font-medium hover:underline" %>
          <% if can_moderate?(post) %>
            <%= button_to "Delete", feed_post_path(post), method: :delete,
                  form: { data: { turbo_confirm: "Delete this post?" } },
                  class: "self-start text-xs text-rose-600 hover:text-rose-800 hover:underline" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
