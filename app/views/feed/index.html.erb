<% content_for :title, "Feed" %>

<h1 class="text-3xl font-extrabold tracking-tight mb-2">Feed</h1>
<p class="text-slate-600 mb-6 text-sm">Share your World Cup moments — photos and videos from the pool.</p>

<% if user_signed_in? %>
  <div class="rounded-xl bg-white shadow p-5 mb-8">
    <%= form_with model: @post, url: feed_path, method: :post, html: { multipart: true, data: { turbo: false } } do |f| %>
      <% if @post.errors.any? %>
        <div class="bg-rose-100 border border-rose-300 text-rose-900 px-4 py-3 rounded-md mb-4 text-sm">
          <ul class="list-disc list-inside">
            <% @post.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <label class="block text-sm font-medium text-slate-700 mb-1">Photo or video</label>
      <%# Direct uploads (browser -> S3) keep big videos off the dyno and away from
          Heroku's 30s timeout. Set ACTIVE_STORAGE_DIRECT_UPLOADS=false to proxy
          uploads through the app instead (no bucket CORS needed). %>
      <% direct_uploads = ActiveModel::Type::Boolean.new.cast(ENV.fetch("ACTIVE_STORAGE_DIRECT_UPLOADS", true)) %>
      <%= f.file_field :media,
            accept: "image/*,video/*",
            required: true,
            direct_upload: direct_uploads,
            class: "block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer mb-4" %>

      <label class="block text-sm font-medium text-slate-700 mb-1">Caption <span class="text-slate-400 font-normal">(optional)</span></label>
      <%= f.text_area :caption,
            rows: 2,
            maxlength: 500,
            placeholder: "Say something about your post…",
            class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-emerald-500 mb-4" %>

      <%= f.submit "Share", class: "px-5 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm cursor-pointer" %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl bg-white shadow p-5 mb-8 text-sm text-slate-600">
    <%= link_to "Sign in", new_user_session_path, class: "text-emerald-700 font-semibold hover:underline" %>
    to share your own photos and videos.
  </div>
<% end %>

<% if @posts.empty? %>
  <div class="rounded-xl bg-white shadow p-10 text-center text-slate-500">
    No posts yet — be the first to share a moment!
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @posts.each do |post| %>
      <div class="rounded-xl bg-white shadow overflow-hidden flex flex-col">
        <div class="bg-slate-900 flex items-center justify-center aspect-square overflow-hidden">
          <% if post.video? %>
            <video controls preload="metadata" class="w-full h-full object-contain bg-black">
              <%= tag.source src: url_for(post.media), type: post.media.content_type %>
              Your browser does not support the video tag.
            </video>
          <% elsif post.image? %>
            <%= link_to feed_post_path(post), class: "block w-full h-full" do %>
              <%= image_tag post.media, class: "w-full h-full object-cover", loading: "lazy", alt: post.caption.presence || "Feed photo" %>
            <% end %>
          <% end %>
        </div>

        <div class="p-4 flex flex-col gap-2 flex-1">
          <% if post.caption.present? %>
            <p class="text-sm text-slate-800 whitespace-pre-line"><%= link_to post.caption, feed_post_path(post), class: "hover:underline" %></p>
          <% end %>
          <div class="mt-auto flex items-center justify-between text-xs text-slate-500 pt-2">
            <span class="font-medium text-slate-700"><%= post.user.display_name %></span>
            <span><%= time_ago_in_words(post.created_at) %> ago</span>
          </div>
          <%= link_to "💬 #{pluralize(post.comments.size, 'comment')}", feed_post_path(post), class: "text-xs text-emerald-700 font-medium hover:underline" %>
          <% if can_moderate?(post) %>
            <%= button_to "Delete", feed_post_path(post), method: :delete,
                  form: { data: { turbo_confirm: "Delete this post?" } },
                  class: "self-start text-xs text-rose-600 hover:text-rose-800 hover:underline" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
