<%# Renders the visual body of a post according to its type. Shared by the feed
    index, the single-post page and admin moderation so every surface shows the
    same thing. Locals:
      post   - the Post to render
      linked - when true, image media links through to the post page (feed grid) %>
<% linked = local_assigns.fetch(:linked, false) %>

<% if post.media? %>
  <div class="bg-slate-900 flex items-center justify-center <%= linked ? "aspect-square" : "max-h-[70vh]" %> overflow-hidden">
    <% if post.video? %>
      <video controls preload="metadata" class="w-full <%= linked ? "h-full" : "max-h-[70vh]" %> object-contain bg-black">
        <%= tag.source src: url_for(post.media), type: post.media.content_type %>
        Your browser does not support the video tag.
      </video>
    <% elsif post.image? %>
      <% if linked %>
        <%= link_to feed_post_path(post), class: "block w-full h-full" do %>
          <%= image_tag post.media, class: "w-full h-full object-cover", loading: "lazy", alt: post.caption.presence || "Feed photo" %>
        <% end %>
      <% else %>
        <%= image_tag post.media, class: "w-full max-h-[70vh] object-contain", alt: post.caption.presence || "Feed photo" %>
      <% end %>
    <% end %>
  </div>

<% elsif post.link? %>
  <%# Rich link preview built from the linked page's Open Graph metadata. %>
  <a href="<%= post.link_url %>" target="_blank" rel="noopener noreferrer nofollow" class="block group">
    <% if post.og_image_url.present? %>
      <div class="bg-slate-100 aspect-[1.91/1] overflow-hidden">
        <%= image_tag post.og_image_url, class: "w-full h-full object-cover", loading: "lazy", alt: post.og_title.presence || "Link preview", referrerpolicy: "no-referrer" %>
      </div>
    <% end %>
    <div class="p-4 border-b border-slate-100">
      <% if post.link_host.present? %>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1 truncate">🔗 <%= post.link_host %></p>
      <% end %>
      <p class="text-sm font-semibold text-slate-800 group-hover:underline line-clamp-2"><%= post.og_title.presence || post.link_url %></p>
      <% if post.og_description.present? %>
        <p class="mt-1 text-sm text-slate-600 line-clamp-3"><%= post.og_description %></p>
      <% end %>
    </div>
  </a>

<% elsif post.instagram? %>
  <div class="flex justify-center bg-white p-2" data-controller="embed" data-embed-platform-value="instagram">
    <blockquote class="instagram-media"
                data-instgrm-permalink="<%= post.embed_permalink %>"
                data-instgrm-version="14"
                style="background:#FFF; border:0; margin:0; max-width:540px; width:100%; min-width:1px;">
      <a href="<%= post.embed_permalink %>" target="_blank" rel="noopener noreferrer">View this post on Instagram</a>
    </blockquote>
  </div>

<% elsif post.threads? %>
  <div class="flex justify-center bg-white p-2" data-controller="embed" data-embed-platform-value="threads">
    <blockquote class="text-post-media"
                data-text-post-permalink="<%= post.embed_permalink %>"
                data-text-post-version="0"
                style="background:#FFF; border:0; margin:0; max-width:540px; width:100%; min-width:1px;">
      <a href="<%= post.embed_permalink %>" target="_blank" rel="noopener noreferrer">View this post on Threads</a>
    </blockquote>
  </div>
<% end %>
