<% content_for :title, "Developer · Edit #{@model.name} ##{@record.id}" %>

<div class="mb-4">
  <%= link_to "← #{@model.name} ##{@record.id}",
              developer_record_path(model: @model.model_name.route_key, id: @record.id),
              class: "text-xs text-slate-500 hover:underline" %>
  <h1 class="text-2xl font-extrabold tracking-tight">Edit <%= @model.name %> #<%= @record.id %></h1>
</div>

<div class="rounded-xl bg-white shadow p-6">
  <%= render "form" %>
</div>
