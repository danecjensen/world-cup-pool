<% content_for :title, "Developer · #{@model.name.pluralize}" %>

<div class="flex items-center justify-between mb-4">
  <div>
    <%= link_to "← Models", developer_root_path, class: "text-xs text-slate-500 hover:underline" %>
    <h1 class="text-2xl font-extrabold tracking-tight"><%= @model.name.pluralize %></h1>
    <% per_page = Developer::RecordsController::PER_PAGE %>
    <% first_row = @total_count.zero? ? 0 : (@page - 1) * per_page + 1 %>
    <% last_row = [@page * per_page, @total_count].min %>
    <p class="text-xs text-slate-500"><code class="font-mono"><%= @model.table_name %></code> · <%= @total_count %> total · showing <%= first_row %>–<%= last_row %> (page <%= @page %> of <%= @total_pages %>) by <code class="font-mono"><%= @sort_column %> <%= @sort_direction %></code></p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Download CSV",
                developer_records_path(model: @model.model_name.route_key, sort: @sort_column, dir: @sort_direction, format: :csv),
                class: "px-3 py-2 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold" %>
    <%= link_to "New #{@model.name}",
                developer_new_record_path(model: @model.model_name.route_key),
                class: "px-3 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold" %>
  </div>
</div>

<div class="rounded-xl bg-white shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
      <tr>
        <% @display_columns.each do |col| %>
          <% if sortable_column?(col) %>
            <% active = col == @sort_column %>
            <% next_dir = (active && @sort_direction == :asc) ? "desc" : "asc" %>
            <% indicator = active ? (@sort_direction == :asc ? " ▲" : " ▼") : "" %>
            <th class="text-left px-3 py-2 font-medium">
              <%= link_to "#{col}#{indicator}",
                          developer_records_path(model: @model.model_name.route_key, sort: col, dir: next_dir),
                          class: "#{active ? 'text-slate-900' : 'text-slate-500'} hover:underline whitespace-nowrap" %>
            </th>
          <% else %>
            <th class="text-left px-3 py-2 font-medium text-slate-500 whitespace-nowrap"><%= col %></th>
          <% end %>
        <% end %>
        <th class="px-3 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @records.each do |record| %>
        <% row = display_row(record) %>
        <tr class="align-top">
          <% @display_columns.each do |col| %>
            <td class="px-3 py-2 font-mono text-xs text-slate-700 max-w-[24ch] truncate" title="<%= row[col] %>">
              <%= row[col].to_s.truncate(48) %>
            </td>
          <% end %>
          <td class="px-3 py-2 text-right whitespace-nowrap">
            <%= link_to "View",   developer_record_path(model: @model.model_name.route_key, id: record.id), class: "text-xs text-slate-700 hover:underline" %>
            <%= link_to "Edit",   developer_edit_record_path(model: @model.model_name.route_key, id: record.id), class: "ml-2 text-xs text-emerald-700 font-semibold hover:underline" %>
            <%= button_to "Delete",
                          developer_record_path(model: @model.model_name.route_key, id: record.id),
                          method: :delete,
                          class: "ml-2 text-xs text-rose-700 font-semibold hover:underline bg-transparent inline",
                          form: { class: "inline", data: { turbo_confirm: "Delete #{@model.name} ##{record.id}?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @total_pages > 1 %>
  <% page_link_opts = ->(page) { { model: @model.model_name.route_key, sort: @sort_column, dir: @sort_direction, page: page } } %>
  <nav class="flex items-center justify-between mt-4 text-sm" aria-label="Pagination">
    <% if @page > 1 %>
      <%= link_to "← Previous", developer_records_path(page_link_opts.call(@page - 1)),
                  class: "px-3 py-2 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold" %>
    <% else %>
      <span class="px-3 py-2 rounded-md bg-slate-50 text-slate-300 font-semibold cursor-not-allowed">← Previous</span>
    <% end %>

    <span class="text-xs text-slate-500">Page <%= @page %> of <%= @total_pages %></span>

    <% if @page < @total_pages %>
      <%= link_to "Next →", developer_records_path(page_link_opts.call(@page + 1)),
                  class: "px-3 py-2 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold" %>
    <% else %>
      <span class="px-3 py-2 rounded-md bg-slate-50 text-slate-300 font-semibold cursor-not-allowed">Next →</span>
    <% end %>
  </nav>
<% end %>
