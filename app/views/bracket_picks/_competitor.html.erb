<%# locals: km, side, team, placeholder, pick, locked %>
<% checked = team && pick&.team_id == team.id %>
<label class="flex items-center gap-2 <%= "cursor-pointer" if team && !locked %>">
  <input type="radio"
         name="picks[<%= km.id %>]"
         value="<%= team&.id %>"
         data-side="<%= side %>"
         data-team-label="<%= team&.name %>"
         data-team-flag="<%= team&.flag_emoji %>"
         data-action="change->bracket#pick"
         <%= "checked" if checked %>
         <%= "disabled" if locked || team.nil? %>
         class="h-5 w-5 text-emerald-600 focus:ring-emerald-500 <%= "hidden" if team.nil? %>">
  <span data-bracket-label="<%= side %>"
        class="font-medium <%= "text-slate-500 italic" if team.nil? %>">
    <%= team ? "#{team.flag_emoji} #{team.name}" : placeholder %>
  </span>
</label>
