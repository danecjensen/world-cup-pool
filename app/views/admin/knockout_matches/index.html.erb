<% content_for :title, "Admin · Knockout" %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-6">
  <h1 class="text-3xl font-extrabold tracking-tight">Knockout matches</h1>
  <%= link_to "Set R32 advancing teams →", admin_advancing_teams_path,
        class: "inline-flex items-center rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 text-sm shadow" %>
</div>
<p class="text-slate-600 -mt-3 mb-6 text-sm max-w-3xl">
  Tip: assign the teams that advanced from each group on the
  <%= link_to "advancing teams page", admin_advancing_teams_path, class: "text-emerald-700 font-medium hover:underline" %>
  so the Round of 32 matchups below fill in with real team names.
</p>

<div class="rounded-xl bg-white shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
      <tr>
        <th class="text-left px-4 py-2">#</th>
        <th class="text-left px-4 py-2">Round</th>
        <th class="text-left px-4 py-2">Matchup</th>
        <th class="text-left px-4 py-2">Kickoff</th>
        <th class="text-right px-4 py-2">Score</th>
        <th class="text-right px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @matches.each do |m| %>
        <tr>
          <td class="px-4 py-2 font-mono text-slate-400"><%= m.number %></td>
          <td class="px-4 py-2"><%= m.round_name %></td>
          <td class="px-4 py-2">
            <%= m.home_team&.name || m.home_slot&.display_label || "TBD" %>
            <span class="text-slate-400 mx-1">vs</span>
            <%= m.away_team&.name || m.away_slot&.display_label || "TBD" %>
          </td>
          <td class="px-4 py-2 text-slate-500 text-xs"><%= m.kickoff_at&.strftime("%b %-d · %-l:%M %p") %></td>
          <td class="px-4 py-2 text-right font-mono">
            <% if m.home_score && m.away_score %>
              <%= m.home_score %>–<%= m.away_score %>
            <% else %>
              <span class="text-slate-300">—</span>
            <% end %>
          </td>
          <td class="px-4 py-2 text-right">
            <%= link_to "Edit", edit_admin_knockout_match_path(m), class: "text-emerald-700 font-medium hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
