<% content_for :title, "Admin · Group pick status" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Group pick status</h1>
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
</div>

<p class="text-sm text-slate-500 mb-4">
  "Yes" means the player has submitted all <%= @total_matches %> group-stage picks.
</p>

<div class="overflow-x-auto rounded-xl bg-white shadow-sm border border-slate-100">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-100">
        <th class="px-4 py-3 font-semibold">Email</th>
        <th class="px-4 py-3 font-semibold">Nickname</th>
        <th class="px-4 py-3 font-semibold text-center">All group picks submitted?</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <% submitted = @total_matches.positive? && @picks_by_user[user.id].to_i >= @total_matches %>
        <tr class="border-b border-slate-50 last:border-0">
          <td class="px-4 py-3 text-slate-600 break-all"><%= user.email %></td>
          <td class="px-4 py-3 font-medium text-slate-800"><%= user.display_name %></td>
          <td class="px-4 py-3 text-center">
            <% if submitted %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">Yes</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                No<span class="ml-1 font-normal text-rose-600">(<%= @picks_by_user[user.id].to_i %>/<%= @total_matches %>)</span>
              </span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
