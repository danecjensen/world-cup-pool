<% content_for :title, "Edit Team" %>

<h1 class="text-2xl font-bold mb-6">Edit team</h1>

<%= form_with model: @team, url: admin_team_path(@team), method: :patch, local: true, html: { class: "space-y-4 max-w-md bg-white p-6 rounded-xl shadow" } do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :code, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :code, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :flag_emoji, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :flag_emoji, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :group_id, "Group", class: "block text-sm font-medium text-slate-700" %>
    <%= f.collection_select :group_id, Group.order(:letter), :id, :letter, { include_blank: "—" }, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Save", class: "bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-md" %>
    <%= link_to "Cancel", admin_teams_path, class: "text-slate-600 px-4 py-2" %>
  </div>
<% end %>
