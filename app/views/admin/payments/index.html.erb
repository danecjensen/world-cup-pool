<% content_for :title, "Admin · Payments" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Payments</h1>
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
</div>

<p class="text-sm text-slate-500 mb-4">Tick the box when a player has paid. Changes save automatically.</p>

<div class="overflow-x-auto rounded-xl bg-white shadow-sm border border-slate-100">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-100">
        <th class="px-4 py-3 font-semibold">Nickname</th>
        <th class="px-4 py-3 font-semibold">Email</th>
        <th class="px-4 py-3 font-semibold text-center">Paid</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-b border-slate-50 last:border-0">
          <td class="px-4 py-3 font-medium text-slate-800"><%= user.display_name %></td>
          <td class="px-4 py-3 text-slate-600 break-all"><%= user.email %></td>
          <td class="px-4 py-3 text-center">
            <%= form_with url: admin_payment_path(user), method: :patch, data: { turbo: false } do %>
              <%= hidden_field_tag "user[paid]", "0" %>
              <%= check_box_tag "user[paid]", "1", user.paid?,
                                onchange: "this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()",
                                class: "h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
