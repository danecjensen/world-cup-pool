<% content_for :title, "Admin · Users" %>

<h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-6">Users</h1>

<div class="space-y-3">
  <% @users.each do |user| %>
    <div class="rounded-xl bg-white shadow-sm border border-slate-100 p-4">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="font-semibold truncate"><%= user.display_name %></div>
          <div class="text-sm text-slate-600 break-all"><%= user.email %></div>
        </div>
        <% if user.admin? %>
          <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">Admin</span>
        <% else %>
          <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">Player</span>
        <% end %>
      </div>

      <div class="mt-2 flex items-center gap-4 text-xs text-slate-500">
        <span><span class="font-mono text-slate-700"><%= @points_by_user[user.id].to_i %></span> pts</span>
        <span>Joined <%= user.created_at.to_date.iso8601 %></span>
      </div>

      <%= form_with url: reset_password_admin_user_path(user), method: :patch,
                    data: { turbo_confirm: "Reset password for #{user.display_name}?" },
                    class: "mt-3 flex flex-col sm:flex-row gap-2" do |f| %>
        <%= f.password_field "user[password]", required: true, minlength: 6,
                             placeholder: "New password",
                             autocomplete: "new-password",
                             class: "flex-1 rounded-lg border border-slate-300 px-3 py-2 text-base" %>
        <%= f.submit "Reset password",
                     class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 cursor-pointer" %>
      <% end %>

      <div class="mt-2">
        <% if user.admin? %>
          <%= button_to "Demote to player",
                        admin_user_path(user, user: { admin: false }),
                        method: :patch,
                        class: "w-full sm:w-auto rounded-lg border border-rose-200 px-4 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-50",
                        form: { data: { turbo_confirm: "Remove admin from #{user.display_name}?" } } %>
        <% else %>
          <%= button_to "Promote to admin",
                        admin_user_path(user, user: { admin: true }),
                        method: :patch,
                        class: "w-full sm:w-auto rounded-lg border border-emerald-200 px-4 py-2.5 text-sm font-semibold text-emerald-700 hover:bg-emerald-50",
                        form: { data: { turbo_confirm: "Make #{user.display_name} an admin?" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
