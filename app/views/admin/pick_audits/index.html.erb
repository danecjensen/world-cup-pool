<% content_for :title, "Admin · Admin-entered picks" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Admin-entered picks</h1>
  <%= link_to "← Back to dashboard", admin_root_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
</div>

<p class="text-sm text-slate-500 mb-4 max-w-3xl">
  Every pick below was created or changed by an admin from the admin portal on a player's behalf
  (for example, picks submitted over email). If a player later changes a pick themselves, it drops
  off this list. Use this page to keep oversight on admin edits, since they affect the standings.
</p>

<% if @picks.empty? %>
  <div class="rounded-xl bg-white shadow-sm border border-slate-100 px-4 py-8 text-center text-slate-500 text-sm">
    No picks have been entered by an admin yet.
  </div>
<% else %>
  <div class="overflow-x-auto rounded-xl bg-white shadow-sm border border-slate-100">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-100">
          <th class="px-4 py-3 font-semibold">Player</th>
          <th class="px-4 py-3 font-semibold">Match</th>
          <th class="px-4 py-3 font-semibold">Round</th>
          <th class="px-4 py-3 font-semibold">Pick</th>
          <th class="px-4 py-3 font-semibold">Last changed</th>
          <th class="px-4 py-3 font-semibold text-right"></th>
        </tr>
      </thead>
      <tbody>
        <% @picks.each do |pick| %>
          <tr class="border-b border-slate-50 last:border-0">
            <td class="px-4 py-3">
              <div class="font-medium text-slate-800"><%= pick.user.display_name %></div>
              <div class="text-xs text-slate-500 break-all"><%= pick.user.email %></div>
            </td>
            <td class="px-4 py-3 text-slate-700"><%= pick.match_label %></td>
            <td class="px-4 py-3 text-slate-500"><%= pick.knockout_match&.round_name || "Group stage" %></td>
            <td class="px-4 py-3 font-semibold text-slate-800"><%= pick.selection_label || "—" %></td>
            <td class="px-4 py-3 text-slate-500 whitespace-nowrap"><%= pick.updated_at.strftime("%b %-d · %-l:%M %p") %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "Edit bracket", admin_user_bracket_picks_path(pick.user), class: "text-emerald-700 font-medium hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
