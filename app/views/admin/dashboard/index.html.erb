<% content_for :title, "Admin" %>

<h1 class="text-3xl font-extrabold tracking-tight mb-6">Admin dashboard</h1>

<div class="grid md:grid-cols-3 gap-4 mb-8">
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Group games</p>
    <p class="text-3xl font-bold mt-1"><%= @group_finished %> / <%= @group_match_count %></p>
    <p class="text-sm text-slate-500">finished</p>
  </div>
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Knockout games</p>
    <p class="text-3xl font-bold mt-1"><%= @knockout_finished %> / <%= @knockout_count %></p>
    <p class="text-sm text-slate-500">finished</p>
  </div>
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Players</p>
    <p class="text-3xl font-bold mt-1"><%= @user_count %></p>
    <p class="text-sm text-slate-500">registered</p>
  </div>
</div>

<section class="rounded-xl bg-white shadow overflow-hidden mb-8">
  <header class="flex flex-wrap items-center justify-between gap-2 bg-gradient-to-r from-rose-600 to-rose-500 text-white px-5 py-4">
    <div>
      <h2 class="font-bold tracking-tight text-lg">Knockout stage</h2>
      <p class="text-sm text-white/80">Administer the bracket and control who can see it.</p>
    </div>
    <% if bracket_visible? %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-400 text-emerald-950 text-sm font-semibold">● Live for all players</span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-300 text-amber-950 text-sm font-semibold">● Admin-only preview</span>
    <% end %>
  </header>

  <div class="p-5 space-y-4">
    <div class="rounded-lg border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="max-w-prose">
        <h3 class="font-semibold">Feature flag — show bracket to users</h3>
        <p class="text-sm text-slate-500 mt-1">
          <% if bracket_visible? %>
            The knockout bracket is <strong>live</strong>: every player sees the Bracket nav link, the home-page CTA, and can submit picks.
          <% else %>
            The knockout bracket is <strong>hidden</strong> from players. Only admins can open it (in preview) to test before launch. Flip this on when you're ready for everyone.
          <% end %>
        </p>
      </div>
      <%= button_to admin_toggle_bracket_visibility_path, method: :post,
                    class: "shrink-0 rounded-lg #{bracket_visible? ? 'bg-amber-600 hover:bg-amber-700' : 'bg-emerald-600 hover:bg-emerald-700'} text-white font-semibold px-5 py-3 shadow" do %>
        <%= bracket_visible? ? "Hide bracket from users" : "Turn on for all players" %>
      <% end %>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <%= link_to admin_advancing_teams_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Set Round of 32 bracket →</h3>
        <p class="text-sm text-slate-500 mt-1">Drop a team into each of the 32 bracket slots by hand so matchups show real names. Winners advance automatically.</p>
      <% end %>
      <%= link_to bracket_picks_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Preview / test the bracket →</h3>
        <p class="text-sm text-slate-500 mt-1">Open the player-facing knockout picks page yourself to test it before flipping the flag.</p>
      <% end %>
      <%= link_to admin_knockout_matches_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Enter knockout results →</h3>
        <p class="text-sm text-slate-500 mt-1">31 bracket matches across 5 rounds, with winner and score entry.</p>
      <% end %>
      <%= link_to admin_knockout_pick_status_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Knockout pick status →</h3>
        <p class="text-sm text-slate-500 mt-1">See who has submitted all 31 of their knockout-stage picks, and enter a bracket on a player's behalf.</p>
      <% end %>
      <%= link_to admin_pick_audits_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Admin-entered picks →</h3>
        <p class="text-sm text-slate-500 mt-1">Audit trail of every pick an admin entered or changed on a player's behalf.</p>
      <% end %>
    </div>

    <% if @pending_bracket_slots.positive? %>
      <p class="text-sm text-slate-500"><%= @pending_bracket_slots %> bracket slots are still unresolved (waiting for group stage results to finalize).</p>
    <% end %>
  </div>
</section>

<section class="rounded-xl bg-white shadow overflow-hidden mb-8">
  <header class="flex flex-wrap items-center justify-between gap-2 bg-gradient-to-r from-sky-600 to-emerald-500 text-white px-5 py-4">
    <div>
      <h2 class="font-bold tracking-tight text-lg">💧 Drip Cup</h2>
      <p class="text-sm text-white/80">Head-to-head "which kit is better?" picker with Elo rankings.</p>
    </div>
    <% if drip_cup_enabled? %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-400 text-emerald-950 text-sm font-semibold">● Live for all players</span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-300 text-amber-950 text-sm font-semibold">● Admin-only preview</span>
    <% end %>
  </header>

  <div class="p-5 space-y-4">
    <div class="rounded-lg border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="max-w-prose">
        <h3 class="font-semibold">Feature flag — open the Drip Cup to users</h3>
        <p class="text-sm text-slate-500 mt-1">
          <% if drip_cup_enabled? %>
            The Drip Cup is <strong>live</strong>: every signed-in player sees the nav link and can vote on kits.
          <% else %>
            The Drip Cup is <strong>hidden</strong> from players. Only admins can open it (in preview) to test before launch. Flip this on when you're ready for everyone.
          <% end %>
        </p>
      </div>
      <%= button_to admin_toggle_drip_cup_path, method: :post,
                    class: "shrink-0 rounded-lg #{drip_cup_enabled? ? 'bg-amber-600 hover:bg-amber-700' : 'bg-emerald-600 hover:bg-emerald-700'} text-white font-semibold px-5 py-3 shadow" do %>
        <%= drip_cup_enabled? ? "Make Drip Cup admin-only" : "Open Drip Cup to all players" %>
      <% end %>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <%= link_to drip_cup_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Open the picker →</h3>
        <p class="text-sm text-slate-500 mt-1">Vote on kit matchups yourself — one design on the top half of the screen, one on the bottom.</p>
      <% end %>
      <%= link_to drip_cup_leaderboard_path, class: "rounded-lg border border-slate-200 p-4 hover:shadow-md block" do %>
        <h3 class="font-semibold">Kit rankings →</h3>
        <p class="text-sm text-slate-500 mt-1">The current Elo table across all kits.</p>
      <% end %>
    </div>
  </div>
</section>

<div class="grid md:grid-cols-2 gap-4 mb-8">
  <%= link_to admin_matches_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Enter group-stage results →</h2>
    <p class="text-sm text-slate-500 mt-1">All 72 fixtures with score entry.</p>
  <% end %>
  <%= link_to admin_teams_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Edit teams / re-seed →</h2>
    <p class="text-sm text-slate-500 mt-1">Rename play-off placeholders, reassign groups.</p>
  <% end %>
  <%= link_to admin_users_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Manage users →</h2>
    <p class="text-sm text-slate-500 mt-1">View all players and promote to admin.</p>
  <% end %>
  <%= link_to admin_payments_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Track payments →</h2>
    <p class="text-sm text-slate-500 mt-1">Tick a box to mark each player as paid.</p>
  <% end %>
  <%= link_to admin_group_pick_status_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Group pick status →</h2>
    <p class="text-sm text-slate-500 mt-1">See who has submitted all their group-stage picks.</p>
  <% end %>
  <%= link_to admin_feed_posts_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">
      Moderate feed
      <% if @pending_post_count.positive? %>
        <span class="ml-1 inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-amber-500 text-white text-xs font-bold"><%= @pending_post_count %></span>
      <% end %>
      →
    </h2>
    <p class="text-sm text-slate-500 mt-1">Approve or reject photos and videos before they hit the feed.</p>
  <% end %>
  <%= button_to admin_recompute_scores_path, method: :post, class: "rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow p-5 text-left w-full" do %>
    <h2 class="font-semibold">Recompute all scores</h2>
    <p class="text-sm opacity-90 mt-1">Re-runs scoring + bracket slot resolution.</p>
  <% end %>
</div>
