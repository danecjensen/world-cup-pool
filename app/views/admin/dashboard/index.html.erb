<% content_for :title, "Admin" %>

<h1 class="text-3xl font-extrabold tracking-tight mb-6">Admin dashboard</h1>

<div class="grid md:grid-cols-3 gap-4 mb-8">
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Group games</p>
    <p class="text-3xl font-bold mt-1"><%= @group_finished %> / <%= @group_match_count %></p>
    <p class="text-sm text-slate-500">finished</p>
  </div>
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Knockout games</p>
    <p class="text-3xl font-bold mt-1"><%= @knockout_finished %> / <%= @knockout_count %></p>
    <p class="text-sm text-slate-500">finished</p>
  </div>
  <div class="rounded-xl bg-white shadow p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Players</p>
    <p class="text-3xl font-bold mt-1"><%= @user_count %></p>
    <p class="text-sm text-slate-500">registered</p>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-4 mb-8">
  <%= link_to admin_matches_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Enter group-stage results →</h2>
    <p class="text-sm text-slate-500 mt-1">All 72 fixtures with score entry.</p>
  <% end %>
  <%= link_to admin_knockout_matches_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Enter knockout results →</h2>
    <p class="text-sm text-slate-500 mt-1">31 bracket matches across 5 rounds.</p>
  <% end %>
  <%= link_to admin_teams_path, class: "rounded-xl bg-white shadow p-5 hover:shadow-md block" do %>
    <h2 class="font-semibold">Edit teams / re-seed →</h2>
    <p class="text-sm text-slate-500 mt-1">Rename play-off placeholders, reassign groups.</p>
  <% end %>
  <%= button_to admin_recompute_scores_path, method: :post, class: "rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow p-5 text-left w-full" do %>
    <h2 class="font-semibold">Recompute all scores</h2>
    <p class="text-sm opacity-90 mt-1">Re-runs scoring + bracket slot resolution.</p>
  <% end %>
</div>

<% if @pending_bracket_slots.positive? %>
  <p class="text-sm text-slate-500"><%= @pending_bracket_slots %> bracket slots are still unresolved (waiting for group stage results to finalize).</p>
<% end %>
