<% content_for :title, "Admin · Knockout pick status" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Knockout pick status</h1>
  <%= link_to "← Back to knockout", admin_knockout_matches_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
</div>

<p class="text-sm text-slate-500 mb-4">
  "Yes" means the player has submitted all <%= @total_matches %> knockout-stage picks
  (Round of 32 through the Final). Use "Edit picks" to enter a bracket on a player's behalf
  (e.g. picks they emailed in) — those edits are flagged and listed on the
  <%= link_to "admin-entered picks page", admin_pick_audits_path, class: "text-emerald-700 font-medium hover:underline" %>.
</p>

<div class="overflow-x-auto rounded-xl bg-white shadow-sm border border-slate-100">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase tracking-wide text-slate-500 border-b border-slate-100">
        <th class="px-4 py-3 font-semibold">Email</th>
        <th class="px-4 py-3 font-semibold">Nickname</th>
        <th class="px-4 py-3 font-semibold text-center">Picks made</th>
        <th class="px-4 py-3 font-semibold text-center">All knockout picks submitted?</th>
        <th class="px-4 py-3 font-semibold text-right"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <% made = @picks_by_user[user.id].to_i %>
        <% submitted = @total_matches.positive? && made >= @total_matches %>
        <tr class="border-b border-slate-50 last:border-0">
          <td class="px-4 py-3 text-slate-600 break-all"><%= user.email %></td>
          <td class="px-4 py-3 font-medium text-slate-800"><%= user.display_name %></td>
          <td class="px-4 py-3 text-center font-mono text-slate-700"><%= made %>/<%= @total_matches %></td>
          <td class="px-4 py-3 text-center">
            <% if submitted %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">Yes</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                No<span class="ml-1 font-normal text-rose-600">(<%= made %>/<%= @total_matches %>)</span>
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <%= link_to "Edit picks", admin_user_bracket_picks_path(user), class: "text-emerald-700 font-medium hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
