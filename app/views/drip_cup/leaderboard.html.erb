<% content_for :title, "Drip Cup rankings" %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-6">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">💧 Drip Cup rankings</h1>
    <p class="text-sm text-slate-500 mt-1">
      Elo ratings from <%= pluralize(@total_votes, "head-to-head vote") %>. Every kit starts at <%= Kit::STARTING_RATING.to_i %>.
    </p>
  </div>
  <%= link_to "Pick some kits →", drip_cup_path,
              class: "rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2.5 shadow" %>
</div>

<% if @kits.none? %>
  <p class="rounded-xl bg-white shadow p-6 text-slate-500">No kits loaded yet — open the picker to get started.</p>
<% else %>
  <div class="rounded-xl bg-white shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3 w-10">#</th>
          <th class="px-4 py-3">Kit</th>
          <th class="px-4 py-3 text-right">Rating</th>
          <th class="px-4 py-3 text-right hidden sm:table-cell">Record</th>
          <th class="px-4 py-3 text-right hidden sm:table-cell">Duels</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @kits.each_with_index do |kit, i| %>
          <tr class="<%= 'bg-amber-50/60' if i < 3 %>">
            <td class="px-4 py-2 font-bold text-slate-400">
              <%= %w[🥇 🥈 🥉][i] || i + 1 %>
            </td>
            <td class="px-4 py-2">
              <div class="flex items-center gap-3">
                <%= image_tag kit.image_path, alt: kit.name, loading: "lazy",
                              class: "h-14 w-14 rounded-md object-contain bg-white border border-slate-200 shrink-0" %>
                <span class="font-semibold"><%= kit.name %></span>
              </div>
            </td>
            <td class="px-4 py-2 text-right font-bold tabular-nums"><%= kit.rating.round %></td>
            <td class="px-4 py-2 text-right text-slate-500 tabular-nums hidden sm:table-cell"><%= kit.wins %>–<%= kit.losses %></td>
            <td class="px-4 py-2 text-right text-slate-500 tabular-nums hidden sm:table-cell"><%= kit.duel_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
