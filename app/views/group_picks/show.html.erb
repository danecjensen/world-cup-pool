<% content_for :title, "My Picks" %>

<div data-controller="group-picks-sort">
  <div class="flex flex-wrap items-end justify-between mb-6 gap-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">My picks</h1>
      <p class="text-slate-600 mt-1 text-sm">Predict the result of each of the 72 group games. 1 point per correct pick. Percentages show how the pool picked.</p>
    </div>
    <% if @locked %>
      <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-rose-100 text-rose-800 text-sm font-medium">🔒 Locked — first match has kicked off</span>
    <% else %>
      <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-sm font-medium">Open until first kickoff</span>
    <% end %>
  </div>

  <div class="flex items-center gap-2 mb-6">
    <span class="text-sm font-medium text-slate-500 mr-1">Sort by</span>
    <div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-sm font-semibold">
      <button type="button"
              data-group-picks-sort-target="groupedBtn"
              data-action="group-picks-sort#showGrouped"
              class="px-3 py-1.5 rounded-md transition">Group</button>
      <button type="button"
              data-group-picks-sort-target="chronoBtn"
              data-action="group-picks-sort#showChronological"
              class="px-3 py-1.5 rounded-md transition">Date</button>
    </div>
  </div>

  <%= form_with url: group_picks_path, method: :patch, local: true, html: { class: "pb-24" } do |f| %>
    <%# Grouped view (default): one card per group %>
    <div data-group-picks-sort-target="grouped" class="space-y-8">
      <% @groups.each do |group| %>
        <section class="rounded-xl bg-white shadow overflow-hidden">
          <header class="bg-gradient-to-r from-emerald-700 to-emerald-600 text-white px-4 sm:px-5 py-3">
            <h2 class="font-bold tracking-tight">Group <%= group.letter %></h2>
          </header>
          <ul id="group-list-<%= group.letter %>" class="divide-y divide-slate-100">
            <% group.matches.sort_by(&:number).each do |m| %>
              <%= render "match", m: m, group: group, pick: @picks_by_match[m.id] %>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>

    <%# Chronological view: a single card holding every game, sorted by kickoff. %>
    <%# Match cards are moved here by the Stimulus controller when toggled on. %>
    <div data-group-picks-sort-target="chronological" class="hidden">
      <section class="rounded-xl bg-white shadow overflow-hidden">
        <header class="bg-gradient-to-r from-emerald-700 to-emerald-600 text-white px-4 sm:px-5 py-3">
          <h2 class="font-bold tracking-tight">All games · by date</h2>
        </header>
        <ul data-group-picks-sort-target="chronoList" class="divide-y divide-slate-100"></ul>
      </section>
    </div>

    <% unless @locked %>
      <div class="fixed bottom-0 inset-x-0 z-20 px-4 py-3 bg-gradient-to-t from-white via-white to-white/80 border-t border-slate-200 shadow-lg sm:static sm:bg-transparent sm:border-0 sm:shadow-none sm:flex sm:justify-end sm:px-0 sm:py-0 sm:mt-8">
        <%= f.submit "Save all picks", class: "w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold px-6 py-3 rounded-lg shadow" %>
      </div>
    <% end %>
  <% end %>
</div>
