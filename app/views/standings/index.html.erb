<% content_for :title, "Standings" %>

<h1 class="text-3xl font-extrabold tracking-tight mb-2">Standings</h1>
<p class="text-slate-600 mb-6 text-sm">Ranked by total points. Ties stay tied.</p>

<div class="rounded-xl bg-white shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
      <tr>
        <th class="text-left px-3 sm:px-4 py-3">#</th>
        <th class="text-left px-3 sm:px-4 py-3">Player</th>
        <th class="hidden sm:table-cell text-right px-4 py-3">Group correct</th>
        <th class="hidden sm:table-cell text-right px-4 py-3">Bracket points</th>
        <th class="text-right px-3 sm:px-4 py-3">Points</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if @players.empty? %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-slate-500">No players yet — be the first to sign up!</td></tr>
      <% end %>
      <% prev_points = nil %>
      <% position = 0 %>
      <% @players.each_with_index do |p, i| %>
        <% if p.total_points != prev_points %>
          <% position = i + 1 %>
          <% prev_points = p.total_points %>
        <% end %>
        <tr class="<%= 'bg-emerald-50/40' if i.zero? %>">
          <td class="px-3 sm:px-4 py-3 font-mono text-slate-400 w-10 align-top sm:align-middle"><%= position %></td>
          <td class="px-3 sm:px-4 py-3 font-medium">
            <%= p.name_with_flag %>
            <div class="sm:hidden mt-0.5 text-xs font-normal text-slate-500">
              Group <%= p.group_correct %> &middot; Bracket <%= p.bracket_points %>
            </div>
          </td>
          <td class="hidden sm:table-cell px-4 py-3 text-right text-slate-600"><%= p.group_correct %></td>
          <td class="hidden sm:table-cell px-4 py-3 text-right text-slate-600"><%= p.bracket_points %></td>
          <td class="px-3 sm:px-4 py-3 text-right font-bold text-emerald-700 align-top sm:align-middle"><%= p.total_points %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
